{
  "name": "filemint",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@hono/node-server": "^2.1.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@sentry/node": "^10.72.0",
    "docx-preview": "^0.4.0",
    "expo": "~57.0.18",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "hono": "^4.13.5",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pptx-preview": "^1.0.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.12.1",
    "read-excel-file": "^9.3.10",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.22.4",
    "zod": "^4.5.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-size": "node scripts/check-file-size.mjs",
    "lint": "eslint src server --max-warnings=0",
    "lint:python": "python -m black --check server && python -m pyflakes server",
    "expo:check": "expo install --check",
    "typecheck": "npm run typecheck:app && npm run typecheck:server",
    "typecheck:app": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:python": "python -m unittest discover -s server/tests -p \"test_*.py\"",
    "test:python:coverage": "python -m coverage run -m unittest discover -s server/tests -p \"test_*.py\" && python -m coverage report",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run test:coverage && npm run test:python:coverage",
    "audit": "node scripts/check-audit-baseline.mjs",
    "verify": "npm run format:check && npm run check:file-size && npm run lint && npm run lint:python && npm run typecheck && npm run test:all && npm run build:web",
    "server": "node --import tsx server/start.ts",
    "server:dev": "node --import tsx --watch server/start.ts",
    "server:smoke": "node --import tsx server/smoke.ts"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "image-size": "2.0.2"
  },
  "private": true
}
