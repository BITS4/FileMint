{
  "name": "filemint",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "dependencies": {
    "@expo/ui": "~56.0.26",
    "@expo/vector-icons": "^15.0.2",
    "@hono/node-server": "^2.1.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/node": "^10.72.0",
    "docx-preview": "^0.3.7",
    "expo": "~56.0.9",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.17",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.12",
    "expo-image-picker": "~56.0.25",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.17",
    "expo-router": "~56.2.20",
    "expo-sharing": "~56.0.16",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "hono": "^4.13.5",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pptx-preview": "^1.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "read-excel-file": "^9.3.10",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.22.4",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src server --max-warnings=0",
    "expo:check": "expo install --check",
    "typecheck": "npm run typecheck:app && npm run typecheck:server",
    "typecheck:app": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "node scripts/check-audit-baseline.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:web",
    "server": "node --import tsx server/start.ts",
    "server:dev": "node --import tsx --watch server/start.ts",
    "server:smoke": "node --import tsx server/smoke.ts"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "image-size": "2.0.2"
  },
  "private": true
}
