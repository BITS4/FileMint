# Runtime
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
FILEMINT_PRODUCTION=false
FILEMINT_PUBLIC_URL=http://localhost:8081
# Optional compatibility aliases; prefer FILEMINT_PUBLIC_URL.
PUBLIC_APP_URL=
APP_URL=
CORS_ORIGINS=http://localhost:8081
FILEMINT_MAX_UPLOAD_BYTES=78643200
EXPO_PUBLIC_FILEMINT_SERVER_URL=http://localhost:8787

# Persistence
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/filemint
DATABASE_POOL_MAX=4

# Email delivery (optional outside production)
RESEND_API_KEY=
FILEMINT_EMAIL_FROM=FileMint <verify@example.com>
RESEND_FROM=

# Stripe Checkout (optional outside production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEK=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=
STRIPE_PRICE_FOREVER=
FILEMINT_ALLOW_DEV_PAYMENTS=false

# Collabora Online
COLLABORA_URL=http://localhost:9980
WOPI_HOST=http://host.docker.internal:8787
COLLABORA_DISCOVERY_REQUEST_TIMEOUT_MS=20000
COLLABORA_DISCOVERY_TIMEOUT_MS=90000
COLLABORA_DETECT_TIMEOUT_MS=90000

# Error reporting (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Hosted OCR tuning
FILEMINT_FAST_HOSTED_OCR=false
FILEMINT_TESSERACT_TIMEOUT_SEC=180

# Injected automatically by test runners, hosting platforms, or Windows.
# Leave blank during ordinary local development.
FILEMINT_SMOKE=
VITEST=
RENDER=
LOCALAPPDATA=
